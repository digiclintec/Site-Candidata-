# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR E API - ALEXSANDRA TOMAZ
# ==============================================================================

# Porta principal da aplicação (HTTP)
PORT=3001

# Endereço de vinculação (0.0.0.0 aceita conexões de qualquer interface)
HOST=0.0.0.0

# Ambiente de execução: development ou production
NODE_ENV=development

# ==============================================================================
# POLÍTICAS DE CORS (Cross-Origin Resource Sharing)
# ==============================================================================
# Origens permitidas: Use '*' para liberar todas ou separe por vírgula para restringir
# Exemplo com restrição: CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,https://alexsandratomaz.com.br
CORS_ORIGIN=*

# Métodos HTTP aceitos pela API
CORS_METHODS=GET, POST, OPTIONS

# Cabeçalhos permitidos nas requisições
CORS_HEADERS=Content-Type, Authorization, X-Requested-With

# ==============================================================================
# PORTA SECUNDÁRIA DE CONVENIÊNCIA
# ==============================================================================
# Habilita ou desabilita o listener secundário (ex: porta 8080)
ENABLE_SECONDARY_PORT=true
SECONDARY_PORT=8080

# ==============================================================================
# DIRETÓRIOS E PERSISTÊNCIA
# ==============================================================================
# Caminho da pasta de persistência dos arquivos JSON (relativo à raiz do Back-end)
DATA_DIR=./data

# Caminho para os arquivos estáticos do Front-End (relativo à raiz do Back-end)
FRONTEND_DIR=../Font-End
